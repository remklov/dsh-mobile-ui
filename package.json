{
  "name": "dsh-mobile-workbench",
  "version": "0.1.0",
  "description": "Authentication-neutral mobile layout and installable PWA for DeepSeek Harness Web.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remklov/dsh-mobile-ui.git"
  },
  "homepage": "https://github.com/remklov/dsh-mobile-ui#readme",
  "bugs": {
    "url": "https://github.com/remklov/dsh-mobile-ui/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "docs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "pwa",
    "responsive"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:auth": "node scripts/test-auth-integration.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run check",
    "icons": "node scripts/icons.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.1 <0.1.6-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "immer": "^10.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zustand": "~4.4.7"
  }
}
